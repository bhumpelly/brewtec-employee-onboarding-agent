            "type": "grafana-postgresql-datasource",
            "uid": "${DS}"
          },
          "rawSql": "select start_date, department, readiness, overdue, open_before_start from reporting.day1_readiness order by start_date",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "readiness"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "GREEN": {
                        "color": "green",
                        "index": 0
                      },
                      "AMBER": {
                        "color": "orange",
                        "index": 1
                      },
                      "RED": {
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
