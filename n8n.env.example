# Template for the n8n container settings. Copy it OUTSIDE the repository
# (for example to $HOME\n8n.env), fill in your values and start n8n with --env-file.
# Never commit the filled file.

# Time
GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin

# Address n8n is reached on (used in approval links and webhooks)
WEBHOOK_URL=http://localhost:5678/

# Only when moving to a new server: the key from the old instance
# N8N_ENCRYPTION_KEY=

# Code nodes and environment access
N8N_RUNNERS_ENABLED=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# LangSmith tracing (EU accounts use the EU endpoint)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=brewtec-onboarding

# Prometheus metrics at /metrics
N8N_METRICS=true
N8N_METRICS_INCLUDE_WORKFLOW_ID_LABEL=true
N8N_METRICS_INCLUDE_MESSAGE_EVENT_BUS_METRICS=true
N8N_METRICS_INCLUDE_API_ENDPOINTS=true
